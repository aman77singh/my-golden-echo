# Server Environment Configuration
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8080

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/our-space?retryWrites=true&w=majority

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Web Push (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:aman@example.com

# Scheduled Jobs / Tick Secret
JOBS_SECRET_KEY=our_space_cron_secret_tick_2026


# Couple Seeding (used by npm run seed:couple)
SEED_HER_NAME=Aditi
SEED_HER_EMAIL=aditi@ourspace.local
SEED_HER_PASSWORD=ChangeMe123!
SEED_HIM_NAME=Aman
SEED_HIM_EMAIL=aman@ourspace.local
SEED_HIM_PASSWORD=ChangeMe123!
SEED_COUPLE_START_DATE=2025-04-16T00:00:00Z
